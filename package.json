{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "nerd-font-woff2",
    "version": "1.0.0",
    "private": true,
    "description": "CLI pipeline for converting Nerd Fonts (and other fonts) from TTF/OTF to WOFF2 assets.",
    "keywords": [
        "fonts",
        "woff2",
        "nerd-fonts",
        "cli",
        "conversion"
    ],
    "homepage": "https://github.com/Nick2bad4u/nerd-fonts-woff2",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/nerd-fonts-woff2/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/nerd-fonts-woff2.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "type": "module",
    "bin": {
        "nerd-font-woff2": "./nerd-font-woff2"
    },
    "files": [
        "nerd-font-woff2",
        "dist",
        "assets",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "node ./src/cli.ts",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:all": "npm run lint:prettier && npm run lint && npm run typecheck",
        "lint:all:fix": "npm run lint:prettier:fix && npm run lint:fix && npm run typecheck",
        "lint:fix": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache --fix",
        "lint:prettier": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --check",
        "lint:prettier:fix": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --write",
        "prepack": "npm run build",
        "release:check": "npm run lint:all && npm test",
        "start": "node ./src/cli.ts",
        "sync:node-version-files": "node scripts/sync-node-version-files.mjs",
        "test": "npm run build && node --test dist/test/**/*.test.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "update-deps": "npx ncu -i --install never && npm run sync:node-version-files && npm install --force"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.6.0",
        "eslint": "^10.3.0",
        "eslint-config-nick2bad4u": "^1.0.11",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "prettier-config-nick2bad4u": "^1.0.10",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.0.1",
        "secretlint": "^13.0.0",
        "secretlint-config-nick2bad4u": "^1.0.4",
        "stylelint": "^17.11.0",
        "stylelint-config-nick2bad4u": "^1.0.9",
        "typescript": "^6.0.3"
    },
    "packageManager": "npm@11.14.0",
    "engines": {
        "node": ">=22.18.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
