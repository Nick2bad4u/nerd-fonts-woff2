{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "nerd-fonts-woff2",
    "version": "1.0.5",
    "private": false,
    "description": "CLI pipeline for converting Nerd Fonts (and other fonts) from TTF/OTF to WOFF2 assets.",
    "keywords": [
        "fonts",
        "woff2",
        "nerdfonts",
        "nerd-font",
        "nerd-fonts",
        "cli",
        "webfont",
        "ttf",
        "conversion"
    ],
    "homepage": "https://nick2bad4u.github.io/nerd-fonts-woff2",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/nerd-fonts-woff2/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/nerd-fonts-woff2.git"
    },
    "license": "MIT",
    "author": {
        "name": "Nick2bad4u",
        "email": "20943337+Nick2bad4u@users.noreply.github.com",
        "url": "https://github.com/Nick2bad4u"
    },
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://github.com/Nick2bad4u"
        }
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/cli.js",
            "types": "./dist/cli.d.ts"
        }
    },
    "main": "./dist/cli.js",
    "types": "./dist/cli.d.ts",
    "bin": {
        "nerd-fonts-woff2": "nerd-fonts-woff2"
    },
    "files": [
        "nerd-fonts-woff2",
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "assets:generate": "npm run fonts:convert",
        "assets:plan": "npm run fonts:plan",
        "build": "tsc -p tsconfig.build.json",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/nerd-fonts-woff2 --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/nerd-fonts-woff2 --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/nerd-fonts-woff2 --current",
        "dev": "node ./src/cli.ts",
        "final": "npm install && npm run build && npm run typecheck && npm run lint:fix:quiet && npm run test && npm run fonts:setup && npm run fonts:check-upstream && npm run fonts:download && npm run fonts:convert && npm run fonts:verify",
        "fonts:check-upstream": "node ./scripts/check-nerd-fonts-updates.mjs",
        "fonts:convert": "node ./scripts/bulk-convert-fonts.mjs",
        "fonts:convert:cli": "npm run build && node ./scripts/convert-font-assets.mjs",
        "fonts:convert:dry-run": "node ./scripts/bulk-convert-fonts.mjs --dry-run",
        "fonts:download": "node ./scripts/download-nerd-fonts-sources.mjs",
        "fonts:local": "npm run fonts:setup && npm run fonts:download && npm run fonts:convert && npm run fonts:verify",
        "fonts:plan": "node ./scripts/bulk-convert-fonts.mjs --dry-run",
        "fonts:setup": "node ./scripts/setup-converter.mjs",
        "fonts:verify": "node ./scripts/verify-font-assets.mjs",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:all": "npm run lint:prettier && npm run lint && npm run typecheck && npm run lint:gitleaks && npm run lint:yamllint",
        "lint:all:fix": "npm run lint:prettier:fix && npm run lint:fix && npm run lint:remark:fix && npm run typecheck",
        "lint:all:fix:quiet": "npm run lint:prettier:fix && npm run lint:fix && npm run typecheck",
        "lint:fix": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache --fix",
        "lint:fix:quiet": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache --fix",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:jscpd": "jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:package-json": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:prettier": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --check",
        "lint:prettier:fix": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --write",
        "lint:remark": "remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "remark . --ignore-path .remarkignore --output",
        "lint:yamllint": "yamllint -c .yamllint .",
        "prepack": "npm run build",
        "release:check": "npm run lint:all && npm test",
        "start": "node ./src/cli.ts",
        "sync:node-version-files": "node scripts/sync-node-version-files.mjs",
        "test": "vitest run --config vite.config.ts",
        "test:ci": "vitest run --config vite.config.ts --coverage --reporter=github-actions --reporter=dot --reporter=junit --outputFile=test-report.junit.xml --silent",
        "test:coverage": "vitest run --config vite.config.ts --coverage",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.eslint.json --noEmit && tsc -p tsconfig.js.json --noEmit",
        "update-actions": "npx actions-up --yes --style sha",
        "update-deps": "ncu --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm run sync:node-version-files && npm update --all --force && npm install --force"
    },
    "dependencies": {
        "ts-extras": "^1.2.0",
        "ttf2woff2": "^8.0.1",
        "type-fest": "^5.8.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.7.0",
        "eslint-config-nick2bad4u": "^5.0.0",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.3.0",
        "gitleaks-config-nick2bad4u": "^1.0.4",
        "globals": "^17.7.0",
        "jscpd": "^5.0.12",
        "jscpd-config-nick2bad4u": "^1.1.0",
        "lychee-config-nick2bad4u": "^2.0.0",
        "ncu-config-nick2bad4u": "^0.2.0",
        "npm-check-updates": "^22.2.9",
        "npm-package-json-lint": "^10.4.1",
        "npm-package-json-lint-config-nick2bad4u": "^1.0.4",
        "prettier": "^3.9.5",
        "prettier-config-nick2bad4u": "^1.1.1",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.3",
        "secretlint": "^13.0.2",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "stylelint": "^17.14.0",
        "stylelint-config-nick2bad4u": "^1.0.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0",
        "vitest": "^4.1.10",
        "yamllint-config-nick2bad4u": "^1.1.1"
    },
    "packageManager": "npm@12.0.1",
    "engines": {
        "node": ">=22.18.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": ">=10.0.0"
        },
        "runtime": {
            "name": "node",
            "version": ">=22.18.0"
        }
    },
    "publishConfig": {
        "provenance": true,
        "registry": "https://registry.npmjs.org"
    }
}
